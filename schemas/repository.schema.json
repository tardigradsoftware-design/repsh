{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repository.schema.json",
  "title": "GitHub Repository Record",
  "description": "Metadata record for an external GitHub repository referenced by this knowledge base.",
  "type": "object",
  "required": ["name", "owner", "url", "description", "category", "license", "stars_checked_at", "status", "confidence"],
  "properties": {
    "name": { "type": "string" },
    "owner": { "type": "string" },
    "url": { "type": "string", "format": "uri" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "language": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"], "description": "SPDX id or null. NEVER redistribute code without a license." },
    "stars": { "type": "integer", "minimum": 0 },
    "forks": { "type": "integer", "minimum": 0 },
    "open_issues": { "type": "integer", "minimum": 0 },
    "stars_checked_at": { "type": "string", "format": "date" },
    "last_push": { "type": "string", "format": "date" },
    "created_at": { "type": "string", "format": "date" },
    "status": { "enum": ["ACTIVE", "STABLE", "MAINTENANCE", "ARCHIVED", "EXPERIMENTAL", "ABANDONED", "UNKNOWN"] },
    "official": { "type": "boolean", "description": "Owned by the canonical organization of the project/standard." },
    "production_ready": { "enum": ["yes", "no", "conditional", "unknown"] },
    "maintenance_status": { "enum": ["active", "regular", "sporadic", "stale", "none"] },
    "security_status": { "enum": ["good", "acceptable", "unknown", "concern"] },
    "documentation_quality": { "enum": ["excellent", "good", "fair", "poor", "unknown"] },
    "community_adoption": { "enum": ["massive", "high", "moderate", "niche", "minimal", "unknown"] },
    "relevance": { "enum": ["core", "high", "medium", "low"] },
    "confidence": { "enum": ["VERY HIGH", "HIGH", "MEDIUM", "LOW", "UNVERIFIED", "CONFLICTING"] },
    "recommended_for": { "type": "array", "items": { "type": "string" } },
    "not_recommended_for": { "type": "array", "items": { "type": "string" } },
    "related_projects": { "type": "array", "items": { "type": "string" } },
    "source_verified": { "type": "boolean" },
    "notes": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
